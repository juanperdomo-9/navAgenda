# Copiá este archivo como .env y completá los valores (el .env nunca se commitea).

# Backend
# Sin definir, se usa el Postgres local de docker-compose (localhost:5433).
# Para Supabase: la "connection string" del proyecto, con el prefijo postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://usuario:password@host:5432/postgres
TEST_DATABASE_URL=postgresql+psycopg://navagenda:navagenda@127.0.0.1:5433/navagenda_test
# "desarrollo" o "produccion" (en producción JWT_SECRET es obligatorio y la cookie exige HTTPS)
ENTORNO=desarrollo
# Clave larga y aleatoria para firmar sesiones, ej.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Clave de los admins de ejemplo que crea el seed (solo desarrollo)
SEED_CLAVE_ADMIN=
CORS_ORIGINS=http://localhost:5173

# Frontend (Vite)
VITE_API_URL=http://localhost:8000

# Avisos por mail al barbero (Brevo). Sin clave no se manda nada.
BREVO_API_KEY=
BREVO_REMITENTE=
